{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "anywhere-ui": {
      "projectType": "library",
      "root": "projects/anywhere-ui",
      "sourceRoot": "projects/anywhere-ui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/anywhere-ui/tsconfig.lib.json",
            "outputPath": "dist/anywhere-ui"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anywhere-ui/tsconfig.lib.prod.json"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
