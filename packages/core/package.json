{
  "name": "@anywhere-ui/core",
  "version": "0.4.0+26",
  "description": "Base components for AnywhereUI",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/anywhere-ui/anywhere-ui.js",
  "keywords": [
    "anywhere-ui",
    "framework",
    "stencil",
    "mobile",
    "app",
    "webapp",
    "capacitor",
    "cordova",
    "electron",
    "progressive web app",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adaleks/anywhere-ui.git"
  },
  "bugs": {
    "url": "https://github.com/adaleks/anywhere-ui/issues"
  },
  "homepage": "https://adaleks.github.io/anywhere-ui-showcase",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "build-doc-json": "stencil build --docs-json src/doc/docs.json",
    "build.watch": "stencil build --dev --watch --serve",
    "build-prerender": "stencil build --prerender",
    "start": "concurrently \"stencil build --dev --watch --serve\" \"npm run watch-scss\"",
    "test": "stencil-test",
    "generate": "stencil generate",
    "watch-scss": "sass --silence-deprecation=import --watch src/app/scss/app.scss:src/app/css/app.css",
    "compress-scss": "sass --silence-deprecation=import --style=compressed src/app/scss/app.scss:src/app/css/app.min.css",
    "deploy-docs": "bash scripts/clear-www.sh && npm run build && node scripts/docs.js && cd www && git add --all && git commit -m \"deployed site to master\" && git push --set-upstream origin master && cd ..",
    "initialize-ghpages": "bash scripts/initialize-stencil-ghpages-repo.sh",
    "deploy-site-to-master": "bash scripts/deploy-site-to-master.sh",
    "test.watch": "stencil-test --watch",
    "test.e2e": "playwright test"
  },
  "devDependencies": {
    "@iconify/iconify": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@stencil/angular-output-target": "^1.6.0",
    "@stencil/core": "^4.45.5",
    "@stencil/playwright": "^0.6.1",
    "@stencil/react-output-target": "^1.8.1",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "^1.16.2",
    "@stencil/vue-output-target": "^0.15.0",
    "@types/clusterize.js": "^0.18.3",
    "@types/lodash": "^4.17.27",
    "clusterize.js": "^1.0.0",
    "concurrently": "^10.0.7",
    "fs-extra": "^11.4.1",
    "jsdom": "^31.0.1",
    "lodash": "^4.18.1",
    "prismjs": "^1.30.0",
    "puppeteer": "^25.19.0",
    "rebase": "^0.3.0",
    "replace": "^1.2.2",
    "sass": "^1.108.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "dependencies": {
    "@anywhere-ui/flex": "^1.0.2",
    "@docsearch/js": "^5.2.0",
    "@types/node": "^26.6.11"
  },
  "buildnum": "26"
}
